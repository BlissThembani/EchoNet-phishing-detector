      "updated": 1795380555836,
      "link": null,
      "locked": false,
      "text": "1. Security & Access Control",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Security & Access Control",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "an",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "text_60",
      "type": "text",
      "x": 64,
      "y": 510,
      "width": 447,
      "height": 168.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1637405850,
      "version": 3,
      "versionNonce": 394419543,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795380554174,
      "link": null,
      "locked": false,
      "text": "• End-to-end HTTPS for every network call.\n\n• All API keys isolated in n8n's encrypted\n  credential store.\n\n• Cloud Run rejects requests without a valid\n  X-API-Key (verified via GCP Secret Manager).\n\n• Full audit trail in Cloud Logging & Supabase.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• End-to-end HTTPS for every network call.\n\n• All API keys isolated in n8n's encrypted\n  credential store.\n\n• Cloud Run rejects requests without a valid\n  X-API-Key (verified via GCP Secret Manager).\n\n• Full audit trail in Cloud Logging & Supabase.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "ao",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
