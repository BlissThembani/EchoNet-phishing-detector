      "link": null,
      "locked": false,
      "text": "3. Orchestration & Resilience",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Orchestration & Resilience",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "at",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "text_66",
      "type": "text",
      "x": 1129,
      "y": 510,
      "width": 447,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 238545459,
      "version": 3,
      "versionNonce": 272117783,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795380560449,
      "link": null,
      "locked": false,
      "text": "• n8n is the single central orchestrator;\n  no external service contacts users directly.\n\n• Redis 24-hour verdict cache speeds up\n  repeat URL checks and lowers API spend.\n\n• Dedicated Error Trigger workflow catches\n  timeouts and sends safe fallback replies.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• n8n is the single central orchestrator;\n  no external service contacts users directly.\n\n• Redis 24-hour verdict cache speeds up\n  repeat URL checks and lowers API spend.\n\n• Dedicated Error Trigger workflow catches\n  timeouts and sends safe fallback replies.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "au",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
