      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "text_63",
      "type": "text",
      "x": 596,
      "y": 510,
      "width": 447,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 516698966,
      "version": 3,
      "versionNonce": 506570935,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795380557437,
      "link": null,
      "locked": false,
      "text": "• Personal information (PII) is redacted inside\n  n8n before storage or AI model calls.\n\n• ML inference runs locally in South Africa\n  (Google Cloud africa-south1, Johannesburg).\n\n• Zero client-side footprint — users interact\n  solely through standard WhatsApp.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Personal information (PII) is redacted inside\n  n8n before storage or AI model calls.\n\n• ML inference runs locally in South Africa\n  (Google Cloud africa-south1, Johannesburg).\n\n• Zero client-side footprint — users interact\n  solely through standard WhatsApp.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "ar",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
