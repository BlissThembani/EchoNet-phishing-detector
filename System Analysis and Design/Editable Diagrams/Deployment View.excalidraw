      "link": null,
      "locked": false,
      "text": "2. Privacy & Data Residency",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Privacy & Data Residency",
      "lineHeight": 1.25,
      "autoResize": true,
